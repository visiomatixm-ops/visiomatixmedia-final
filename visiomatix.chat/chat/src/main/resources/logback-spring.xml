<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

    <!-- ========================================================= -->
    <!-- LOGBACK CONFIGURATION FILE FOR SPRING BOOT PROJECT        -->
    <!-- Author : Viral Prajapati                                   -->
    <!-- Date   : 15-Oct-2025                                       -->
    <!-- Description :                                              
         - Console logging with timestamp
         - Daily rotated log files (date-based)
         - Separate error log for API exceptions
         - Hibernate SQL and Spring Web debug tracking
    -->
    <!-- ========================================================= -->

    <!-- Directory for logs -->
    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_FILE" value="app-log-%d{yyyy-MM-dd}.log" />
    <!-- Log pattern with timestamps and thread info -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console Appender (development use) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Rolling File Logging -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roll daily and keep 14 days -->
            <fileNamePattern>${LOG_PATH}/app-log-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>


    <!-- Separate error log -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>15</maxHistory>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Hibernate SQL debug logs -->
    <logger name="org.hibernate.SQL" level="ERROR"/>
    <logger name="org.hibernate.type.descriptor.sql" level="TRACE"/>

    <!-- Spring web debug logs -->
    <logger name="org.springframework.web" level="ERROR"/>
    <logger name="org.springframework.security" level="ERROR"/>

    <!-- Your project package debug level -->
    <logger name="com.visiomatix.chat" level="ERROR"/>

    <!-- Root logger configuration -->
    <root level="ERROR">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
