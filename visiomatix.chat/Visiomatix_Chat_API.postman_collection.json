	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const responseJson = pm.response.json();",
									"    pm.test('User registered successfully', function () {",
									"        pm.expect(responseJson).to.have.property('username');",
									"        pm.expect(responseJson).to.have.property('email');",
									"        pm.expect(responseJson).to.have.property('id');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{test_username}}\",\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\",\n    \"name\": \"{{test_name}}\",\n    \"active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"register"
							]
						},
						"description": "Register a new user account. No authentication required."
					},
					"response": []
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const responseJson = pm.response.json();",
									"    pm.test('Login successful', function () {",
									"        pm.expect(responseJson).to.have.property('token');",
									"        pm.expect(responseJson).to.have.property('username');",
									"        pm.expect(responseJson).to.have.property('role');",
									"    });",
									"    ",
									"    // Store JWT token for future requests",
									"    pm.environment.set('jwt_token', responseJson.token);",
									"    pm.environment.set('current_username', responseJson.username);",
									"    pm.environment.set('current_role', responseJson.role);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{login_username}}\",\n    \"password\": \"{{login_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"login"
							]
						},
						"description": "Authenticate user and receive JWT token. Token is automatically stored in environment variable."
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for user registration and login"
		},
